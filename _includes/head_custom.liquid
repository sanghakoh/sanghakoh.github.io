<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

<style>
  :root {
    --sun-blue: #0e4a8a;
    --sun-blue-dark: #0c3e75;
    --sun-gray: #898c8e;
    --sun-ink: #1f2937;
    --sun-surface: #f7f9fc;
    --sun-border: #e6eaef;
    --global-theme-color: #0e4a8a;
    --global-hover-color: #0c3e75;
  }

  /* ---------- Typography ---------- */
  body {
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    line-height: 1.72;
    -webkit-font-smoothing: antialiased;
  }
  h1, h2, h3, h4 { font-weight: 700; letter-spacing: -0.015em; }
  a { color: var(--sun-blue); transition: color 0.15s ease; }
  a:hover { color: var(--sun-blue-dark); }
  ::selection { background: rgba(14, 74, 138, 0.15); }

  .page h2, .post h2, article h2 {
    color: var(--sun-blue);
    font-size: 1.45rem;
    margin-top: 2.2rem;
    padding-bottom: 0.35rem;
    border-bottom: 2px solid var(--sun-border);
  }
  .page h3, article h3 { color: var(--sun-ink); }

  /* ---------- Home: hero ---------- */
  .lab-hero {
    border-radius: 18px;
    background: #0e4a8a;
    color: #fff;
    text-align: center;
    padding: 3rem 1.8rem;
    margin: 1.2rem 0 3rem;
    box-shadow: 0 10px 30px rgba(14, 74, 138, 0.22);
  }
  .lab-hero .lab-name { font-size: 1.9rem; font-weight: 800; line-height: 1.25; margin: 0 0 0.4rem; color: rgba(255, 255, 255, 0.9); letter-spacing: -0.02em; }
  .lab-hero .lab-name .sun { color: #fff; }
  .lab-hero .lab-abbr { letter-spacing: 0.22em; font-weight: 700; color: #fff; opacity: 0.95; margin: 0.2rem 0 1.1rem; font-size: 0.95rem; }
  .lab-hero .lab-tagline { font-size: 1.08rem; max-width: 52ch; margin: 0 auto 0.8rem; color: rgba(255, 255, 255, 0.92); line-height: 1.65; }
  .lab-hero .lab-affil { font-size: 0.9rem; color: rgba(255, 255, 255, 0.72); margin: 0; }

  /* ---------- Home: research cards ---------- */
  .research-grid { display: flex; flex-wrap: wrap; gap: 1.4rem; justify-content: center; margin: 1.5rem 0; }
  .research-card {
    flex: 1 1 240px; max-width: 320px; text-align: center;
    background: #fff; border: 1px solid var(--sun-border); border-radius: 16px;
    padding: 2rem 1.5rem;
    box-shadow: 0 2px 10px rgba(14, 74, 138, 0.05);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .research-card:hover { transform: translateY(-4px); box-shadow: 0 12px 28px rgba(14, 74, 138, 0.12); }
  .research-card img { width: 150px; height: 150px; }
  .research-card h3 { margin: 1.1rem 0 0.5rem; color: var(--sun-blue); font-size: 1.18rem; }
  .research-card p { font-size: 0.94rem; line-height: 1.6; color: var(--sun-gray); }

  /* ---------- Join Us ---------- */
  .joinus {
    border: 1px solid var(--sun-border); border-top: 4px solid var(--sun-blue);
    border-radius: 16px; background: var(--sun-surface);
    text-align: center; padding: 2.6rem 1.8rem; margin: 2.4rem 0;
  }
  .joinus .joinus-title { color: var(--sun-blue); font-size: 1.6rem; font-weight: 800; margin-bottom: 1.2rem; letter-spacing: -0.02em; }
  .joinus p { color: var(--sun-gray); max-width: 56ch; margin: 0 auto 0.8rem; line-height: 1.65; }
  .joinus .email-btn {
    display: inline-block; margin-top: 1.4rem; background: var(--sun-blue); color: #fff;
    font-weight: 600; padding: 0.75rem 1.7rem; border-radius: 999px; text-decoration: none;
    box-shadow: 0 4px 14px rgba(14, 74, 138, 0.28); transition: transform 0.15s ease, background 0.15s ease;
  }
  .joinus .email-btn:hover { background: var(--sun-blue-dark); color: #fff; transform: translateY(-2px); }

  /* ---------- Contact ---------- */
  .contact-wrap { display: flex; flex-wrap: wrap; gap: 1.5rem; align-items: stretch; margin-top: 1.5rem; }
  .contact-card { flex: 1 1 320px; background: var(--sun-surface); border: 1px solid var(--sun-border); border-radius: 16px; padding: 2rem; }
  .contact-card .lab-name { color: var(--sun-blue); font-size: 1.3rem; font-weight: 700; margin: 0 0 1.4rem; }
  .contact-row { display: flex; gap: 1rem; margin-bottom: 1.1rem; line-height: 1.55; }
  .contact-row .label { color: var(--sun-blue); font-weight: 700; min-width: 72px; }
  .contact-row .value { color: var(--sun-gray); }
  .contact-row .value a { color: var(--sun-blue); }
  .contact-map { flex: 1 1 360px; min-height: 340px; }
  .contact-map iframe { width: 100%; height: 100%; min-height: 340px; border: 0; border-radius: 16px; }

  /* ---------- Publications ---------- */
  .me { font-weight: 700; text-decoration: underline; text-underline-offset: 2px; }
  .venue {
    display: inline-block; background: #eaf1f9; color: var(--sun-blue);
    font-weight: 600; font-size: 0.76rem; letter-spacing: 0.02em;
    padding: 0.2rem 0.6rem; border-radius: 999px; border: 1px solid #d6e2f0; margin-right: 0.45rem;
  }
  .pdf-btn {
    display: inline-block; background: var(--sun-ink); color: #fff;
    font-weight: 600; font-size: 0.74rem; letter-spacing: 0.04em;
    padding: 0.22rem 0.7rem; border-radius: 999px; text-decoration: none; margin-top: 0.45rem;
    transition: background 0.15s ease;
  }
  .pdf-btn:hover { background: #000; color: #fff; }
  .page li { margin-bottom: 1.2rem; line-height: 1.55; }
</style>
